# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Secrets / local config
.env
*.key
*.pem
configs/config.toml
configs/*.local.*

# Data / models (keep out of Git). Uses "data/*" rather than "data/" so the
# negation below can still reach inside the directory (git cannot re-include
# paths under a directory that was itself excluded outright).
data/*
datasets/
models/
checkpoints/
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors
*.h5

# Exception: the hand-seeded, version-controlled PUE catalogue and knowledge
# artifacts are source, not generated data/model output (see
# docs/architecture/PUE_v0.1_VERTICAL_SLICE_SPECIFICATION.md section 12).
!data/pue/
!data/pue/**

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
